# Параметры развертывания Hive (ДЗ-3)

# Узлы кластера (из ДЗ-1 и ДЗ-2)
EDGE_HOST=team-21-en          # здесь запускаются скрипты, здесь же работают Metastore и HiveServer2
NN_HOST=team-21-nn            # NameNode, ResourceManager; здесь ставится PostgreSQL
NM_HOSTS="team-21-nn team-21-00 team-21-01"

# Пользователи
HADOOP_USER=hadoop
ADMIN_USER=team
ADMIN_SSH_KEY=/home/team/.ssh/team_internal   # ключ team для sudo на внутренних узлах (как в ДЗ-1)

# Java и Hadoop
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
# HIVE_JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64   # раскомментировать, если Hive не стартует на Java 11
HADOOP_HOME=/home/hadoop/hadoop-3.4.0

# Дистрибутив Hive
HIVE_VERSION=4.0.0-alpha-2
HIVE_URL=https://archive.apache.org/dist/hive/hive-${HIVE_VERSION}/apache-hive-${HIVE_VERSION}-bin.tar.gz
HIVE_HOME=/home/hadoop/apache-hive-${HIVE_VERSION}-bin
HIVE_HEAPSIZE_MB=1024         # heap для Metastore и HiveServer2

# Metastore DB (PostgreSQL на NN_HOST). Пароль хранится в secrets.env (создается автоматически, в git не попадает)
PG_HOST=${NN_HOST}
PG_PORT=5432
METASTORE_DB=metastore
METASTORE_DB_USER=hive
HIVE_CLIENT_CIDR=10.21.0.10/32   # адрес edge, с которого Metastore подключается к PostgreSQL

# Порты Hive
METASTORE_PORT=9083
HS2_PORT=10000
HS2_WEBUI_PORT=10002

# Каталоги в HDFS
HIVE_WAREHOUSE=/user/hive/warehouse
DATA_ROOT=/data/hw3                # здесь лежат исходные файлы и данные партиционированной таблицы

# Данные
HIVE_DB=hw3
GEN_ROWS=50000                     # сколько строк сгенерировать, если файл не передан
