# NameNode
# здесь же будут ResourceManager и JobHistory Server
NN_HOST=team-21-nn

# Остальные DataNode
DN_HOSTS="team-21-00 team-21-01"

#Узлы на которых работают NodeManager (все 3 с DataNode)
NM_HOSTS="team-21-nn team-21-00 team-21-01"

# Пользователь и каталог Hadoop
HADOOP_USER=hadoop
HADOOP_HOME=/home/hadoop/hadoop-3.4.0

# Ресурсы которые каждый NodeManager отдает под контейнеры
NM_MEMORY_MB=2048
NM_VCORES=2
CONTAINER_MB=512

# Порты на которых веб-интерфейсы доступны снаружи
NN_PUBLIC_PORT=9870
RM_PUBLIC_PORT=8088
JHS_PUBLIC_PORT=19888
NM_PUBLIC_PORT_BASE=8042

PUBLISH_NAMENODE=false